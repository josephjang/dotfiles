font-family = "Operator Mono SSm Lig"
# Light style is good for Operator Mono SSm Lig
font-style = "Light"
font-style-italic = "Light Italic"

font-size = 13

window-width = 110
window-height = 38
window-padding-x = 6
window-padding-y = 4

# Load Homebrew's PATH, then attach to an existing session or create one.
# Ghostty's command launcher does not source .zshrc.
command = /bin/zsh -lc 'source "$HOME/.exports"; if tmux has-session 2>/dev/null; then exec tmux attach-session; else exec tmux new-session; fi'

macos-option-as-alt = left

theme = Dimidium

#window-decoration = none
gtk-titlebar = false
macos-titlebar-style = "hidden"
