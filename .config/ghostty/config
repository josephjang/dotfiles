font-family = "Operator Mono SSm Lig"
# Light style is good for Operator Mono SSm Lig
font-style = "Light"
font-style-italic = "Light Italic"

font-size = 13

window-width = 110
window-height = 38
window-padding-x = 6
window-padding-y = 4

# Attach every terminal to the same named tmux session.
command = "tmux new-session -A -s main"

macos-option-as-alt = left

theme = Dimidium

#window-decoration = none
gtk-titlebar = false
macos-titlebar-style = "hidden"
