#! /bin/sh

#
# EDITOR
#
if hash nvim 2> /dev/null; then
	export EDITOR=nvim
elif hash vim 2> /dev/null; then
	export EDITOR=vim
fi

#
# PAGER
#
# https://github.com/rkitover/vimpager
#
if hash vimpager 2> /dev/null; then
	export PAGER=vimpager
fi

#
# less
#
export LESS=-R
export LESS_TERMCAP_mb=$'\E[1;31m'     # begin blink
export LESS_TERMCAP_md=$'\E[1;36m'     # begin bold
export LESS_TERMCAP_me=$'\E[0m'        # reset bold/blink
export LESS_TERMCAP_so=$'\E[01;44;33m' # begin reverse video
export LESS_TERMCAP_se=$'\E[0m'        # reset reverse video
export LESS_TERMCAP_us=$'\E[1;32m'     # begin underline
export LESS_TERMCAP_ue=$'\E[0m'        # reset underline

#
# MAVEN_OPTS
#
export MAVEN_OPTS="-Xmx1g"

#
# GOPATH
#
export GOPATH=$HOME/.local/share/go
export GOBIN=$GOPATH/bin

#
# Homebrew
#
# shellenv puts Homebrew's bin and sbin on PATH on Apple Silicon. On Intel
# Macs, /usr/local/bin is already on the default PATH.
#
if test -s "/opt/homebrew/bin/brew"; then
	eval "$(/opt/homebrew/bin/brew shellenv)"
fi

#
# XDG_BIN_HOME
#
export XDG_BIN_HOME=$HOME/.local/bin


export CARGO_BIN="$HOME/.cargo/bin"

export GOLAND_BIN="/opt/goland/bin"

#
# PATH
#
# This file is sourced again by shells that inherit PATH (a shell inside
# tmux, a nested login shell), so each entry is added only when missing.
# An empty directory is skipped: an empty PATH entry means the current
# directory.
#
_path_prepend() {
	[ -n "$1" ] || return 0
	case ":$PATH:" in
		*":$1:"*) ;;
		*) PATH="$1${PATH:+:$PATH}" ;;
	esac
}

_path_append() {
	[ -n "$1" ] || return 0
	case ":$PATH:" in
		*":$1:"*) ;;
		*) PATH="${PATH:+$PATH:}$1" ;;
	esac
}

_path_prepend "$XDG_BIN_HOME"
_path_append "$GOBIN"
_path_append "$CARGO_BIN"
_path_append "$GOLAND_BIN"
export PATH

unset -f _path_prepend _path_append

